<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>To-Do List App</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
    <div class="container">
        <div class="todo-app">
            <h1>To-Do App</h1>
            <div class="stat-container">
                <div class="details">
                    <h3>Keep it Up!</h3>
                    <div id="progressbar">
                        <div id="progress"style="width:<%= todos.length ? (todos.filter(t => t.done).length / todos.length) * 100 : 0 %>%"></div>
                    </div>
                </div>
                <div class="stats-number">
                    <p id="numbers"><%= todos.filter(t => t.done).length %> / <%= todos.length %></p>
                </div>
            </div>
            <form action="/add" method="POST" class="input-area" id="todo-form">
                 <input type="hidden" name="id" id="edit-id" value="">
                <input type="text" name="task" id="task-input" placeholder="Add a new task...">
            <button type="submit" id="add-task-button"><i class="fa-solid fa-plus"></i></button>
            </form>
            <div class="todos-container">
                <% if(todos.length === 0) {%>
                    <img class="empty-image" id="empty-image" src="./images/empty.avif" alt="empty"/>
                <% } else {%>
                    <ul id="task-list">
                        <% todos.forEach(todo => { %>
                            <li class="<%= todo.done ? 'completed' : '' %>">
                                <span><%= todo.task %></span>
                                  
                                <div class="actions">
                                    <% if(!todo.done) { %>
                                        <form action="/done/<%=todo.id %>" method="POST" style="display:inline;">
                                            <button type="submit" class="done-btn"><i class="fa-solid fa-check"></i></button>
                                        </form>
                                    <% } %>
                                        <button type="submit" class="edit-btn"><a href="/edit-todo/<%= todo.id %>"><i class="fa-solid fa-pen"></i></a></button>
                                        
                                    <form action="/delete/<%= todo.id %>" method="POST" style="display:inline;">
                                         <button type="submit" class="delete-btn"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </div>

                                </li> 
                        <% }) %>   
                    </ul>
                <% } %>
                
                
               
            </div>
        </div>

    </div>
    <script src="/script.js"></script>
</body>
</html>